  { "op": "insert", "coll": "intentions", "row": "int-realize", "values": { "title": { "t": "text", "v": "Intent is faithfully realized" }, "statement": { "t": "text", "v": "That what we intend actually, truthfully comes to be — the gap between the intended world and the built world closed without loss. (The first intention: it serves nothing beyond itself.)" }, "intendedBy": { "t": "enum", "set": "intendedBy", "v": "both" }, "status": { "t": "enum", "set": "intentionStatus", "v": "active" } } },
  { "op": "insert", "coll": "intentions", "row": "int-noloss", "values": { "title": { "t": "text", "v": "Intent survives the building" }, "statement": { "t": "text", "v": "The requirements, decisions and the why stay attached to what is built, so the map keeps matching the territory." }, "serves": { "t": "ref", "collection": "intentions", "id": "int-realize" }, "intendedBy": { "t": "enum", "set": "intendedBy", "v": "both" }, "status": { "t": "enum", "set": "intentionStatus", "v": "active" } } },
  { "op": "insert", "coll": "intentions", "row": "int-scale", "values": { "title": { "t": "text", "v": "Many authors build reliably at scale" }, "statement": { "t": "text", "v": "Human and AI co-create systems too complex for one mind, and they stay coherent and truthful." }, "serves": { "t": "ref", "collection": "intentions", "id": "int-noloss" }, "intendedBy": { "t": "enum", "set": "intendedBy", "v": "both" }, "status": { "t": "enum", "set": "intentionStatus", "v": "active" } } },
  { "op": "insert", "coll": "intentions", "row": "int-collab", "values": { "title": { "t": "text", "v": "Model-driven AI + human collaboration" }, "statement": { "t": "text", "v": "A model-driven, self-documenting collaboration between AI and human — where the model is the application and its own record, incorruptible for many authors." }, "serves": { "t": "ref", "collection": "intentions", "id": "int-scale" }, "intendedBy": { "t": "enum", "set": "intendedBy", "v": "both" }, "status": { "t": "enum", "set": "intentionStatus", "v": "active" } } },

  { "op": "insert", "coll": "decisions", "row": "dec-start", "values": { "title": { "t": "text", "v": "Start with the Requirement and Decision models" }, "context": { "t": "text", "v": "The journey must be self-hosting; the two seams that let us record every later requirement and decision come first." }, "rationale": { "t": "text", "v": "Smallest slice that exercises choice, a relation, computed-down effort, and the Place law — and lets us dogfood immediately." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "process" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-reqdec" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-configurator", "values": { "title": { "t": "text", "v": "Model a decision as a configurator" }, "context": { "t": "text", "v": "A decision that is only prose records intent but constrains nothing downstream." }, "rationale": { "t": "text", "v": "Options are rows with computed consequences; commit exactly one. An ADR is a CPQ configurator." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-optionsrows" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-ground", "values": { "title": { "t": "text", "v": "Ground every type in HQDM, enforced by the gate" }, "context": { "t": "text", "v": "Multi-agent authoring needs an incorruptible, shared spine." }, "rationale": { "t": "text", "v": "An enforced reduce-check makes grounding a property of the build, not a discipline." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-hqdm" } } },

  { "op": "insert", "coll": "options", "row": "opt-reqdec", "values": { "title": { "t": "text", "v": "Requirement + Decision models first" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" }, "summary": { "t": "text", "v": "Two seams that let the model record everything else; dogfood now." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-sixseam", "values": { "title": { "t": "text", "v": "Full six-seam journey up front" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" }, "summary": { "t": "text", "v": "Intent through Release before any use — a big bang." }, "size": { "t": "enum", "set": "optionSize", "v": "XL" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-log", "values": { "title": { "t": "text", "v": "Keep the tracker, add a decisions log" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" }, "summary": { "t": "text", "v": "Cheapest, but stays a tracker; decisions don't constrain downstream." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-optionsrows", "values": { "title": { "t": "text", "v": "Options as rows, consequences computed, commit one" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-configurator" }, "summary": { "t": "text", "v": "The ADR-as-configurator; effort computed from size." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-freeprose", "values": { "title": { "t": "text", "v": "Decision as a free-text record" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-configurator" }, "summary": { "t": "text", "v": "Just prose; no computed consequences, nothing to constrain the plan." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-hqdm", "values": { "title": { "t": "text", "v": "Reduce every type to HQDM, enforced" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-ground" }, "summary": { "t": "text", "v": "Grounding guaranteed; ungrounded types can't land." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-adhoc", "values": { "title": { "t": "text", "v": "Ad-hoc type tags, no lattice" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-ground" }, "summary": { "t": "text", "v": "Fast but ungrounded; drift returns." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },

  { "op": "insert", "coll": "requirements", "row": "req-drive", "values": { "title": { "t": "text", "v": "The model drives development" }, "statement": { "t": "text", "v": "Domain facts and the work that makes them are computed from the model, not tracked beside it." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "every model node traces to a committed decision" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "inspection" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-incorrupt", "values": { "title": { "t": "text", "v": "Many agents co-author without corruption" }, "statement": { "t": "text", "v": "Any author — human or AI — is held to the same enforced contract." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "an ungrounded, mistyped, or homeless change returns exit 1" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "test" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-ground", "values": { "title": { "t": "text", "v": "Every node reduces to HQDM" }, "statement": { "t": "text", "v": "The model is grounded in a shared upper ontology from day one." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "reduces(x) is true for every type, semanticClass, and category" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "test" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-ground" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-configurator", "values": { "title": { "t": "text", "v": "A decision computes its options' consequences" }, "statement": { "t": "text", "v": "Choosing is picking a row whose effort and risk are computed, not typing a verdict." }, "kind": { "t": "enum", "set": "reqKind", "v": "functional" }, "priority": { "t": "enum", "set": "reqPriority", "v": "should" }, "criterion": { "t": "text", "v": "each option's effort is computed from its size, not entered" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "demonstration" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-configurator" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },

  { "op": "insert", "coll": "decisions", "row": "dec-selfhost", "values": { "title": { "t": "text", "v": "Record the platform's own design in the platform" }, "context": { "t": "text", "v": "Where should the requirements and decisions about this system live?" }, "rationale": { "t": "text", "v": "In the model: a single source, homed by the Place law, that the next agent inherits. A spec beside the model would drift and is blocked by the model/ JSON-only hook." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "governance" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-inmodel" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-envelope", "values": { "title": { "t": "text", "v": "Lift CollectionDoc to Configurator; a requirement is a configurator" }, "context": { "t": "text", "v": "A requirement cannot be a row — its criterion, verify method, and triggered decisions are consequences of its category, not values you type." }, "rationale": { "t": "text", "v": "The schema language becomes one shape (fields + options + tables + validations + outputs); a plain collection is the degenerate case, and the requirement computes its own criterion." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-envelope" } } },

  { "op": "insert", "coll": "options", "row": "opt-inmodel", "values": { "title": { "t": "text", "v": "Capture requirements + decisions + docs in the model" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-selfhost" }, "summary": { "t": "text", "v": "Dogfood; single source; homed by the Place law." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-extdocs", "values": { "title": { "t": "text", "v": "Write specs as external documents" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-selfhost" }, "summary": { "t": "text", "v": "Familiar, but drifts from the model and violates one-truth; blocked by the model/ hook." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-chatonly", "values": { "title": { "t": "text", "v": "Leave the design in chat" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-selfhost" }, "summary": { "t": "text", "v": "Ephemeral; lost to the next agent; not incorruptible." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-envelope", "values": { "title": { "t": "text", "v": "Configurator envelope: fields + options + tables + validations + outputs" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" }, "summary": { "t": "text", "v": "A requirement computes its own criterion; a collection is the degenerate configurator." }, "size": { "t": "enum", "set": "optionSize", "v": "L" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-keepcoll", "values": { "title": { "t": "text", "v": "Keep CollectionDoc plus a separate spec" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" }, "summary": { "t": "text", "v": "Less engine work, but a requirement stays a row that can't compute its own shape." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-tags", "values": { "title": { "t": "text", "v": "Ad-hoc category tags on rows" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" }, "summary": { "t": "text", "v": "Cheapest; no computed criterion, no routing — stays a tracker." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },

  { "op": "insert", "coll": "requirements", "row": "req-selfhost", "values": { "title": { "t": "text", "v": "The platform's design lives in the platform" }, "statement": { "t": "text", "v": "Requirements and decisions about the system are captured in the system, not in external docs or chat." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "no design artifact lives outside the model" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "inspection" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-selfhost" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-reqconfig", "values": { "title": { "t": "text", "v": "A requirement is a configurator" }, "statement": { "t": "text", "v": "Its criterion, verification method, and triggered decisions are computed from its category and parameters, not typed. A row is one committed run of it." }, "kind": { "t": "enum", "set": "reqKind", "v": "functional" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "a requirement computes its own acceptance criterion" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "demonstration" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-envelope", "values": { "title": { "t": "text", "v": "Collections generalize to configurators" }, "statement": { "t": "text", "v": "One schema language: stored + computed fields, plus optional choices, tables, validations, and outputs." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "should" }, "criterion": { "t": "text", "v": "a collection is a configurator with no choices, tables, or outputs" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "analysis" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" } } },
  { "op": "insert", "coll": "requirements", "row": "req-perf", "values": { "title": { "t": "text", "v": "The recompute cascade stays snappy" }, "statement": { "t": "text", "v": "Editing a value and seeing the rollups settle must feel instant." }, "kind": { "t": "enum", "set": "reqKind", "v": "performance" }, "priority": { "t": "enum", "set": "reqPriority", "v": "should" }, "criterion": { "t": "text", "v": "cascade settle time within target" }, "observable": { "t": "enum", "set": "metric", "v": "cascade_ms" }, "comparator": { "t": "enum", "set": "cmp", "v": "lte" }, "target": { "t": "num", "v": 50 }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "test" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-envelope" } } },

  { "op": "insert", "coll": "decisions", "row": "dec-predicate", "values": { "title": { "t": "text", "v": "The criterion is a first-class predicate that runs as the gate" }, "context": { "t": "text", "v": "How is a requirement's 'done' decided — and how does the acceptance criterion become the verification gate?" }, "rationale": { "t": "text", "v": "Build the criterion from the choices as a deferred predicate value, then run it against measured evidence with a guard. The same object authored at Requirements is what runs at Verification." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-predicate-value" } } },

  { "op": "insert", "coll": "options", "row": "opt-predicate-value", "values": { "title": { "t": "text", "v": "Criterion as a first-class predicate (build + check)" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-predicate" }, "summary": { "t": "text", "v": "Authored once, runs later; 'done' is a predicate that evaluates against evidence." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-text-criterion", "values": { "title": { "t": "text", "v": "Criterion as prose text" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-predicate" }, "summary": { "t": "text", "v": "Readable, but never runs — 'done' stays a manual judgement." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-external-checker", "values": { "title": { "t": "text", "v": "Check criteria in external code" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-predicate" }, "summary": { "t": "text", "v": "Powerful but off-model; the gate drifts from the requirement it checks." }, "size": { "t": "enum", "set": "optionSize", "v": "L" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },

  { "op": "insert", "coll": "requirements", "row": "req-runnable", "values": { "title": { "t": "text", "v": "A requirement's 'done' is a predicate that runs" }, "statement": { "t": "text", "v": "Verification evaluates the requirement's own acceptance predicate against evidence — it is not a status someone flips." }, "kind": { "t": "enum", "set": "reqKind", "v": "functional" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "met is computed by running the criterion against measured evidence" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "demonstration" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-predicate" } } },

  { "op": "insert", "coll": "decisions", "row": "dec-reground", "values": { "title": { "t": "text", "v": "Correct the HQDM groundings" }, "context": { "t": "text", "v": "An HQDM deep-dive found mis-groundings: Decision over-claimed agreement; Option under-read as sign; category conflates value-class with relation-class; a requirement fuses the spec (a class of states) with its evidence (an individual state)." }, "rationale": { "t": "text", "v": "Apply the safe one-line fixes now (Decision->activity, Option->possible_world) and stage the deeper splits (evidence-as-state, transition-as-event, split category) so every step stays gate-green." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-reground" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-reflective", "values": { "title": { "t": "text", "v": "Re-base on a reflective metamodel (schema is data)" }, "context": { "t": "text", "v": "The schema-tier vs row-tier split is the root of the row misnomer, the ungoverned decisions, and the classification/individual confusion. HQDM is self-describing: class, class_of_class, and the relations are themselves entities." }, "rationale": { "t": "text", "v": "Make Collection/Property/Type themselves collections; make classifiedBy (instanceOf) first-class beside specializes; make the class-vs-individual boundary a computed extent; run ONE gate over all nodes. No new value kind or op — only where schema is read from changes. Staged migration; Stages 1a-3 shipped." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-reflective" } } },

  { "op": "insert", "coll": "options", "row": "opt-reground", "values": { "title": { "t": "text", "v": "Correct groundings now, stage the deeper splits" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reground" }, "summary": { "t": "text", "v": "Decision->activity, Option->possible_world today; evidence/transition/category splits staged." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-keep-groundings", "values": { "title": { "t": "text", "v": "Leave the mis-groundings" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reground" }, "summary": { "t": "text", "v": "Cheapest, but the model stays HQDM-flavoured, not HQDM-correct." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-reflective", "values": { "title": { "t": "text", "v": "Collection/Property/Type become collections; one gate over nodes" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reflective" }, "summary": { "t": "text", "v": "Dissolves the tier split; classifiedBy first-class; extent computed; reduces walks Type-rows. Staged." }, "size": { "t": "enum", "set": "optionSize", "v": "XL" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-two-tier", "values": { "title": { "t": "text", "v": "Keep the schema-tier vs row-tier split" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reflective" }, "summary": { "t": "text", "v": "Status quo; rows stay second-class and ungoverned; the fractal stays a metaphor." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },

  { "op": "insert", "coll": "requirements", "row": "req-four-relations", "values": { "title": { "t": "text", "v": "Classification, specialization, temporal_part_of and composition stay four distinct relations" }, "statement": { "t": "text", "v": "Membership (instance-of), subtype (isA), temporal parthood and spatial part-of are different relations and must not be collapsed into one another." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "no relation kind is expressed via another (classification is not specialization)" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "inspection" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reground" } } },
  { "op": "insert", "coll": "requirements", "row": "req-reflective-unity", "values": { "title": { "t": "text", "v": "Schema and data are one self-similar structure" }, "statement": { "t": "text", "v": "A collection, a property and a type are themselves rows in collections; there is one kind of node, governed uniformly, terminating in individuals." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "the gate applies the same laws to a collection, a property and an instance" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "demonstration" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reflective" } } },
  { "op": "insert", "coll": "requirements", "row": "req-spec-vs-evidence", "values": { "title": { "t": "text", "v": "A requirement is a class of satisfying states; its evidence is a separate individual state" }, "statement": { "t": "text", "v": "The requirement_specification (spec) and the measured evidence classified against it are different HQDM levels and must not live on one row; met is a classification of the evidence state against the spec." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "measured/met/verified live on an observation individual classified by the spec, not on the spec" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "inspection" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-reflective" } } },

  { "op": "insert", "coll": "observations", "row": "obs-perf", "values": { "requirement": { "t": "ref", "collection": "requirements", "id": "req-perf" }, "measured": { "t": "num", "v": 32 } } },

  { "op": "insert", "coll": "decisions", "row": "dec-doc-shape", "values": { "title": { "t": "text", "v": "Documentation is structured, not prose" }, "context": { "t": "text", "v": "Docs today are prose {home,title,body} records, checked only for placement (the Place law) — and they drifted ahead of the code, hand-authoring mechanism claims a machine can't verify." }, "rationale": { "t": "text", "v": "A Doc is a typed sign with SHAPE: subject (the node), role, audience, status, and an authored `intent` (the only prose). Its `what` (mechanism) and `provenance` (which decision/intention produced the node) are DERIVED projections over the model, never authored. The doc-view renders that structure; folded into the outward build." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "data-model" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-doc-structured" } } },

  { "op": "insert", "coll": "options", "row": "opt-doc-structured", "values": { "title": { "t": "text", "v": "Docs are typed sign-records + derived layers, rendered as a projection" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-doc-shape" }, "summary": { "t": "text", "v": "subject/role/audience/status/intent as typed properties; what + provenance derived from the node; only intent is authored." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },
  { "op": "insert", "coll": "options", "row": "opt-doc-prose", "values": { "title": { "t": "text", "v": "Keep prose body records" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-doc-shape" }, "summary": { "t": "text", "v": "Readable, but drift-prone; a prose body can hand-author mechanism claims that lie." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },

  { "op": "insert", "coll": "requirements", "row": "req-docs-structured", "values": { "title": { "t": "text", "v": "Documentation is structured data, not prose" }, "statement": { "t": "text", "v": "A doc is a typed record — subject, role, audience, status, and an authored intent — whose mechanism and provenance are derived projections over the model. Only intent is hand-authored." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "no doc hand-authors mechanism; what-it-is and why-it-exists are derived from the node" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "inspection" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-doc-shape" } } },

  { "op": "insert", "coll": "types", "row": "Actor", "values": { "specializes": { "t": "list", "of": { "k": "ref", "collection": "types" }, "items": [{ "t": "ref", "collection": "types", "id": "party" }] } } },
  { "op": "insert", "coll": "types", "row": "Grant", "values": { "specializes": { "t": "list", "of": { "k": "ref", "collection": "types" }, "items": [{ "t": "ref", "collection": "types", "id": "association" }] } } },

  { "op": "insert", "coll": "actors", "row": "a-admin", "values": { "name": { "t": "text", "v": "Ross (owner)" }, "kind": { "t": "enum", "set": "actorKind", "v": "human" }, "status": { "t": "enum", "set": "actorStatus", "v": "active" } } },
  { "op": "insert", "coll": "actors", "row": "a-agent", "values": { "name": { "t": "text", "v": "Claude (agent)" }, "kind": { "t": "enum", "set": "actorKind", "v": "agent" }, "status": { "t": "enum", "set": "actorStatus", "v": "active" } } },
  { "op": "insert", "coll": "actors", "row": "a-observer", "values": { "name": { "t": "text", "v": "Guest" }, "kind": { "t": "enum", "set": "actorKind", "v": "human" }, "status": { "t": "enum", "set": "actorStatus", "v": "active" } } },

  { "op": "insert", "coll": "grants", "row": "g-admin", "values": { "actor": { "t": "ref", "collection": "actors", "id": "a-admin" }, "scope": { "t": "enum", "set": "authScope", "v": "admin" } } },
  { "op": "insert", "coll": "grants", "row": "g-agent", "values": { "actor": { "t": "ref", "collection": "actors", "id": "a-agent" }, "scope": { "t": "enum", "set": "authScope", "v": "write" } } },

  { "op": "insert", "coll": "decisions", "row": "dec-auth", "values": { "title": { "t": "text", "v": "Authenticate the actor; authorize writes model-first" }, "context": { "t": "text", "v": "Any client could self-declare its actor and write, and PUT /workspace was open. 'Incorruptible for many authors' was only a correctness gate, never an authority boundary." }, "rationale": { "t": "text", "v": "The deployment holds a token→actor trust anchor (a secret); the model's grants (an actor→scope association) drive authorization; the DO stamps the VERIFIED actor and refuses unauthorized writes and schema changes fail-closed. A bootstrap-admin list breaks the genesis chicken-and-egg. Reads stay open; every mutation is authored by a verified actor." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "level": { "t": "enum", "set": "decisionLevel", "v": "design" }, "kind": { "t": "enum", "set": "decisionKind", "v": "governance" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-auth-envtrust" } } },

  { "op": "insert", "coll": "options", "row": "opt-auth-envtrust", "values": { "title": { "t": "text", "v": "Env token→actor anchor + model-driven grants; DO enforces and stamps" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-auth" }, "summary": { "t": "text", "v": "Real authority boundary now; the engine stays neutral (grant field names come from config); the anchor is swappable for an IdP later." }, "size": { "t": "enum", "set": "optionSize", "v": "M" }, "risk": { "t": "enum", "set": "riskLevel", "v": "low" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-auth-open", "values": { "title": { "t": "text", "v": "Leave the actor self-declared" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-auth" }, "summary": { "t": "text", "v": "The status quo: any caller writes as any actor; no authority boundary at all." }, "size": { "t": "enum", "set": "optionSize", "v": "S" }, "risk": { "t": "enum", "set": "riskLevel", "v": "high" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "reversible" } } },
  { "op": "insert", "coll": "options", "row": "opt-auth-idp", "values": { "title": { "t": "text", "v": "Full external identity provider (OAuth/SSO) now" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-auth" }, "summary": { "t": "text", "v": "Production-grade, but premature; the token anchor covers the demo and deploy, and the IdP can replace it behind the same seam." }, "size": { "t": "enum", "set": "optionSize", "v": "XL" }, "risk": { "t": "enum", "set": "riskLevel", "v": "med" }, "reversibility": { "t": "enum", "set": "reversibility", "v": "oneway" } } },

  { "op": "insert", "coll": "requirements", "row": "req-auth", "values": { "title": { "t": "text", "v": "Every write is authored by a verified actor" }, "statement": { "t": "text", "v": "No write or schema change lands unless the requester presents a credential the server verifies to an actor authorized for that action, and the verified actor is recorded. Reads stay open." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "an unauthenticated or unauthorized mutation returns 401/403 and persists nothing; the oplog records the verified actor, never a client-declared string" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "test" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "intention": { "t": "ref", "collection": "intentions", "id": "int-collab" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-auth" } } }
]
