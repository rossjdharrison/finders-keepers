  { "op": "insert", "coll": "requirements", "row": "req-incorrupt", "values": { "title": { "t": "text", "v": "Many agents co-author without corruption" }, "statement": { "t": "text", "v": "Any author — human or AI — is held to the same enforced contract." }, "kind": { "t": "enum", "set": "reqKind", "v": "constraint" }, "priority": { "t": "enum", "set": "reqPriority", "v": "must" }, "criterion": { "t": "text", "v": "an ungrounded, mistyped, or homeless change returns exit 1" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "test" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-start" } } },
