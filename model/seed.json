  { "op": "insert", "coll": "decisions", "row": "dec-start", "values": { "title": { "t": "text", "v": "Start with the Requirement and Decision models" }, "context": { "t": "text", "v": "The journey must be self-hosting; the two seams that let us record every later requirement and decision come first." }, "rationale": { "t": "text", "v": "Smallest slice that exercises choice, a relation, computed-down effort, and the Place law — and lets us dogfood immediately." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-reqdec" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-configurator", "values": { "title": { "t": "text", "v": "Model a decision as a configurator" }, "context": { "t": "text", "v": "A decision that is only prose records intent but constrains nothing downstream." }, "rationale": { "t": "text", "v": "Options are rows with computed consequences; commit exactly one. An ADR is a CPQ configurator." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-optionsrows" } } },
  { "op": "insert", "coll": "decisions", "row": "dec-ground", "values": { "title": { "t": "text", "v": "Ground every type in HQDM, enforced by the gate" }, "context": { "t": "text", "v": "Multi-agent authoring needs an incorruptible, shared spine." }, "rationale": { "t": "text", "v": "An enforced reduce-check makes grounding a property of the build, not a discipline." }, "status": { "t": "enum", "set": "decisionStatus", "v": "accepted" }, "chosen": { "t": "ref", "collection": "options", "id": "opt-hqdm" } } },

