  { "op": "insert", "coll": "requirements", "row": "req-configurator", "values": { "title": { "t": "text", "v": "A decision computes its options' consequences" }, "statement": { "t": "text", "v": "Choosing is picking a row whose effort and risk are computed, not typing a verdict." }, "kind": { "t": "enum", "set": "reqKind", "v": "functional" }, "priority": { "t": "enum", "set": "reqPriority", "v": "should" }, "criterion": { "t": "text", "v": "each option's effort is computed from its size, not entered" }, "verifyMethod": { "t": "enum", "set": "verifyMethod", "v": "demonstration" }, "status": { "t": "enum", "set": "reqStatus", "v": "accepted" }, "decision": { "t": "ref", "collection": "decisions", "id": "dec-configurator" } } }
