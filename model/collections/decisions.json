{
  "id": "decisions",
  "semanticClass": "Decision",
  "properties": [
    { "id": "title", "valueType": { "k": "text" }, "source": "stored" },
    { "id": "context", "valueType": { "k": "text" }, "source": "stored" },
    { "id": "rationale", "valueType": { "k": "text" }, "source": "stored" },
    { "id": "status", "valueType": { "k": "enum", "set": "decisionStatus" }, "source": "stored", "category": "state" },
    { "id": "chosen", "valueType": { "k": "ref", "collection": "options" }, "source": "stored", "category": "association" },
    {
      "id": "optionCount", "valueType": { "k": "num" }, "source": "computed", "category": "physical_quantity",
      "formula": { "op": "rollup", "via": "options", "agg": "count", "of": { "op": "field", "id": "title" } }
    },
    {
      "id": "satisfies", "valueType": { "k": "num" }, "source": "computed", "category": "physical_quantity",
      "formula": { "op": "rollup", "via": "requirements", "agg": "count", "of": { "op": "field", "id": "title" } }
    },
    {
      "id": "mustSatisfied", "valueType": { "k": "num" }, "source": "computed", "category": "physical_quantity",
      "formula": { "op": "rollup", "via": "requirements", "agg": "sum", "of": { "op": "field", "id": "isMust" } }
    }
  ]
}
