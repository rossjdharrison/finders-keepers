{
  "kind": "journey",
  "id": "auto-package",
  "title": "Autopakket",
  "doc": "De volledige autoreis bij Rowblaa Bank: verzekering én financiering in één maandbedrag. Twee getypte L2-naden binden de losse producten samen — de cataloguswaarde uit de verzekering wordt het te financieren bedrag, en uw schadevrije jaren geven een loyaliteitskorting op de rente. Aanbetaling en inruil verlagen het te financieren bedrag. Alles gecomponeerd via relaties + rollup in dezelfde verzegelde @core, zonder enige codewijziging.",
  "locale": "nl",
  "models": [
    { "ref": "car-insurance", "as": "ins" },
    { "ref": "financing", "as": "fin" }
  ],
  "spine": "fin",
  "bindings": [
    {
      "id": "valToPrincipal",
      "from": "ins",
      "to": "fin",
      "contract": {
        "provides": [{ "as": "vval", "source": "output:vehicleValue" }],
        "requires": [{ "name": "vval", "target": "field:principal" }]
      },
      "mapping": [{ "to": "principal", "from": { "op": "field", "id": "vval" } }]
    },
    {
      "id": "noClaimToLoyalty",
      "from": "ins",
      "to": "fin",
      "contract": {
        "provides": [{ "as": "nc", "source": "output:schadevrijeJaren" }],
        "requires": [{ "name": "nc", "target": "field:loyaltyYears" }]
      },
      "mapping": [{ "to": "loyaltyYears", "from": { "op": "field", "id": "nc" } }]
    }
  ],
  "surface": [
    { "as": "insPremium", "from": "ins", "field": "premium", "label": "Verzekering p/m" }
  ],
  "total": { "field": "combinedMonthly", "of": ["insPremium", "finMonthly"], "label": "Maandbedrag", "per": "per maand" },
  "sections": [
    { "model": "ins", "label": "Verzekering", "fields": ["plate", "vehicleDesc", "vehicleValue", "schadevrijeJaren", "cover", "optLegalAid", "premium"] },
    { "model": "fin", "label": "Financiering", "fields": ["principal", "downPayment", "tradeIn", "termMonths", "loyaltyYears", "annualRate", "finMonthly"] }
  ]
}
