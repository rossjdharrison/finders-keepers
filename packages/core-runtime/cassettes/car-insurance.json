{
  "id": "car-insurance",
  "title": "Rowblaa Autoverzekering — aanvragen",
  "doc": "Een aanvraagreis voor een autoverzekering bij Rowblaa Bank. Het model berekent de premie stapsgewijs uit het voertuig, de bestuurder en de gekozen dekking; elke stap is bewaakt (guarded) en de premie is een transparante optelling van opslagen minus de no-claimkorting. Ook de presentatie is model-gestuurd: merk, taal, teksten en stijl komen alle uit deze cassette, niet uit code.",
  "locale": "nl",
  "types": {
    "Application": { "specializes": ["activity"] },
    "Vehicle": { "specializes": ["ordinary_physical_object"] },
    "Cover": { "specializes": ["possible_world"] },
    "Driver": { "specializes": ["party"] }
  },
  "collections": [
    {
      "id": "applications",
      "semanticClass": "Application",
      "doc": "Eén autoverzekeringsaanvraag: de door de klant ingevoerde gegevens, de velden die externe bronnen (RDW-kenteken, regio) automatisch aanvullen, en de daaruit berekende premie-opbouw.",
      "properties": [
        { "id": "step", "valueType": { "k": "enum", "set": "step" }, "source": "stored", "category": "class_of_state" },

        { "id": "plate", "valueType": { "k": "text" }, "source": "stored", "constraint": { "format": "kenteken" } },
        { "id": "vehicleConfirmed", "valueType": { "k": "bool" }, "source": "stored", "availableWhen": { "op": "ne", "args": [{ "op": "field", "id": "vehicleDesc" }, { "op": "lit", "value": { "t": "blank" } }] } },
        { "id": "vehicleDesc", "valueType": { "k": "text" }, "source": "extern", "api": "rdwDesc", "params": { "plate": "plate" } },
        { "id": "vehicleValue", "valueType": { "k": "money" }, "source": "extern", "api": "rdwValue", "params": { "plate": "plate" }, "category": "amount_of_money" },

        { "id": "postcode", "valueType": { "k": "text" }, "source": "stored", "constraint": { "format": "postcode" } },
        { "id": "houseNumber", "valueType": { "k": "text" }, "source": "stored" },
        { "id": "street", "valueType": { "k": "text" }, "source": "extern", "api": "addrStreet", "params": { "postcode": "postcode" } },
        { "id": "city", "valueType": { "k": "text" }, "source": "extern", "api": "regionCity", "params": { "postcode": "postcode" } },
        { "id": "regionBand", "valueType": { "k": "enum", "set": "regionBand" }, "source": "extern", "api": "regionBand", "params": { "postcode": "postcode" } },
        { "id": "age", "valueType": { "k": "num" }, "source": "stored", "category": "physical_quantity", "constraint": { "min": 16, "max": 100 } },
        { "id": "schadevrijeJaren", "valueType": { "k": "num" }, "source": "stored", "category": "physical_quantity", "constraint": { "min": 0, "max": 99 } },
        { "id": "annualKm", "valueType": { "k": "num" }, "source": "stored", "category": "physical_quantity", "constraint": { "min": 0, "max": 200000 } },
        { "id": "usage", "valueType": { "k": "enum", "set": "usage" }, "source": "stored" },
        { "id": "driverConfirmed", "valueType": { "k": "bool" }, "source": "stored" },

        { "id": "cover", "valueType": { "k": "enum", "set": "coverLevel" }, "source": "stored" },
        { "id": "coverConfirmed", "valueType": { "k": "bool" }, "source": "stored" },
        { "id": "optLegalAid", "valueType": { "k": "bool" }, "source": "stored" },
        { "id": "optPassenger", "valueType": { "k": "bool" }, "source": "stored" },
        { "id": "optRoadside", "valueType": { "k": "bool" }, "source": "stored" },
        { "id": "optNoClaimProtect", "valueType": { "k": "bool" }, "source": "stored", "availableWhen": { "op": "gte", "args": [{ "op": "field", "id": "schadevrijeJaren" }, { "op": "lit", "value": { "t": "num", "v": 5 } }] } },

        { "id": "startDate", "valueType": { "k": "date" }, "source": "stored", "category": "point_in_time" },
        { "id": "paymentTerm", "valueType": { "k": "enum", "set": "paymentTerm" }, "source": "stored" },
        { "id": "termsAccepted", "valueType": { "k": "bool" }, "source": "stored" },

        {
          "id": "valueBand", "valueType": { "k": "enum", "set": "coverBand" }, "source": "computed",
          "formula": { "op": "call", "fn": "if", "args": [
            { "op": "lt", "args": [{ "op": "field", "id": "vehicleValue" }, { "op": "lit", "value": { "t": "money", "minor": 1000000, "ccy": "EUR", "scale": 2 } }] },
            { "op": "lit", "value": { "t": "enum", "set": "coverBand", "v": "low" } },
            { "op": "call", "fn": "if", "args": [
              { "op": "lt", "args": [{ "op": "field", "id": "vehicleValue" }, { "op": "lit", "value": { "t": "money", "minor": 2500000, "ccy": "EUR", "scale": 2 } }] },
              { "op": "lit", "value": { "t": "enum", "set": "coverBand", "v": "mid" } },
              { "op": "lit", "value": { "t": "enum", "set": "coverBand", "v": "high" } }
            ] }
          ] }
        },
        {
          "id": "ageBand", "valueType": { "k": "enum", "set": "ageBand" }, "source": "computed",
          "formula": { "op": "call", "fn": "if", "args": [
            { "op": "lt", "args": [{ "op": "field", "id": "age" }, { "op": "lit", "value": { "t": "num", "v": 23 } }] },
            { "op": "lit", "value": { "t": "enum", "set": "ageBand", "v": "young" } },
            { "op": "call", "fn": "if", "args": [
              { "op": "lt", "args": [{ "op": "field", "id": "age" }, { "op": "lit", "value": { "t": "num", "v": 65 } }] },
              { "op": "lit", "value": { "t": "enum", "set": "ageBand", "v": "standard" } },
              { "op": "lit", "value": { "t": "enum", "set": "ageBand", "v": "senior" } }
            ] }
          ] }
        },
        {
          "id": "kmBand", "valueType": { "k": "enum", "set": "kmBand" }, "source": "computed",
          "formula": { "op": "call", "fn": "if", "args": [
            { "op": "lt", "args": [{ "op": "field", "id": "annualKm" }, { "op": "lit", "value": { "t": "num", "v": 10001 } }] },
            { "op": "lit", "value": { "t": "enum", "set": "kmBand", "v": "low" } },
            { "op": "call", "fn": "if", "args": [
              { "op": "lt", "args": [{ "op": "field", "id": "annualKm" }, { "op": "lit", "value": { "t": "num", "v": 20001 } }] },
              { "op": "lit", "value": { "t": "enum", "set": "kmBand", "v": "mid" } },
              { "op": "lit", "value": { "t": "enum", "set": "kmBand", "v": "high" } }
            ] }
          ] }
        },
        {
          "id": "sjBand", "valueType": { "k": "enum", "set": "sjBand" }, "source": "computed",
          "formula": { "op": "call", "fn": "if", "args": [
            { "op": "lt", "args": [{ "op": "field", "id": "schadevrijeJaren" }, { "op": "lit", "value": { "t": "num", "v": 5 } }] },
            { "op": "lit", "value": { "t": "enum", "set": "sjBand", "v": "none" } },
            { "op": "call", "fn": "if", "args": [
              { "op": "lt", "args": [{ "op": "field", "id": "schadevrijeJaren" }, { "op": "lit", "value": { "t": "num", "v": 10 } }] },
              { "op": "lit", "value": { "t": "enum", "set": "sjBand", "v": "mid" } },
              { "op": "call", "fn": "if", "args": [
                { "op": "lt", "args": [{ "op": "field", "id": "schadevrijeJaren" }, { "op": "lit", "value": { "t": "num", "v": 15 } }] },
                { "op": "lit", "value": { "t": "enum", "set": "sjBand", "v": "high" } },
                { "op": "lit", "value": { "t": "enum", "set": "sjBand", "v": "max" } }
              ] }
            ] }
          ] }
        },

        { "id": "coverBase", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "lookup", "table": "coverRate", "key": { "op": "field", "id": "cover" } } },
        { "id": "bandSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "eq", "args": [{ "op": "field", "id": "vehicleValue" }, { "op": "lit", "value": { "t": "blank" } }] }, { "op": "lit", "value": { "t": "blank" } }, { "op": "lookup", "table": "bandRate", "key": { "op": "field", "id": "valueBand" } }] } },
        { "id": "ageSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "eq", "args": [{ "op": "field", "id": "age" }, { "op": "lit", "value": { "t": "blank" } }] }, { "op": "lit", "value": { "t": "blank" } }, { "op": "lookup", "table": "ageRate", "key": { "op": "field", "id": "ageBand" } }] } },
        { "id": "kmSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "eq", "args": [{ "op": "field", "id": "annualKm" }, { "op": "lit", "value": { "t": "blank" } }] }, { "op": "lit", "value": { "t": "blank" } }, { "op": "lookup", "table": "kmRate", "key": { "op": "field", "id": "kmBand" } }] } },
        { "id": "regionSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "lookup", "table": "regionRate", "key": { "op": "field", "id": "regionBand" } } },
        { "id": "usageSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "lookup", "table": "usageRate", "key": { "op": "field", "id": "usage" } } },

        { "id": "optLegalAidFee", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "field", "id": "optLegalAid" }, { "op": "lit", "value": { "t": "money", "minor": 300, "ccy": "EUR", "scale": 2 } }, { "op": "lit", "value": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }] } },
        { "id": "optPassengerFee", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "field", "id": "optPassenger" }, { "op": "lit", "value": { "t": "money", "minor": 150, "ccy": "EUR", "scale": 2 } }, { "op": "lit", "value": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }] } },
        { "id": "optRoadsideFee", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "field", "id": "optRoadside" }, { "op": "lit", "value": { "t": "money", "minor": 200, "ccy": "EUR", "scale": 2 } }, { "op": "lit", "value": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }] } },
        { "id": "optNoClaimFee", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "field", "id": "optNoClaimProtect" }, { "op": "lit", "value": { "t": "money", "minor": 250, "ccy": "EUR", "scale": 2 } }, { "op": "lit", "value": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }] } },
        { "id": "optionsTotal", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "add", "args": [{ "op": "field", "id": "optLegalAidFee" }, { "op": "field", "id": "optPassengerFee" }] }, { "op": "add", "args": [{ "op": "field", "id": "optRoadsideFee" }, { "op": "field", "id": "optNoClaimFee" }] }] } },

        { "id": "subVehicle", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "field", "id": "coverBase" }, { "op": "field", "id": "bandSurcharge" }] } },
        { "id": "subDriver", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "field", "id": "ageSurcharge" }, { "op": "field", "id": "kmSurcharge" }] } },
        { "id": "subContext", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "field", "id": "regionSurcharge" }, { "op": "field", "id": "usageSurcharge" }] } },
        { "id": "gross", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "add", "args": [{ "op": "field", "id": "subVehicle" }, { "op": "field", "id": "subDriver" }] }, { "op": "add", "args": [{ "op": "field", "id": "subContext" }, { "op": "field", "id": "optionsTotal" }] }] } },
        { "id": "noClaimDiscount", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "eq", "args": [{ "op": "field", "id": "schadevrijeJaren" }, { "op": "lit", "value": { "t": "blank" } }] }, { "op": "lit", "value": { "t": "blank" } }, { "op": "lookup", "table": "ncDiscount", "key": { "op": "field", "id": "sjBand" } }] } },
        { "id": "netPremium", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "sub", "args": [{ "op": "field", "id": "gross" }, { "op": "field", "id": "noClaimDiscount" }] } },
        { "id": "paymentSurcharge", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "call", "fn": "if", "args": [{ "op": "eq", "args": [{ "op": "field", "id": "paymentTerm" }, { "op": "lit", "value": { "t": "enum", "set": "paymentTerm", "v": "monthly" } }] }, { "op": "lit", "value": { "t": "money", "minor": 50, "ccy": "EUR", "scale": 2 } }, { "op": "lit", "value": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }] } },
        { "id": "premium", "valueType": { "k": "money" }, "source": "computed", "category": "amount_of_money", "formula": { "op": "add", "args": [{ "op": "field", "id": "netPremium" }, { "op": "field", "id": "paymentSurcharge" }] } },

        { "id": "vehicleReady", "valueType": { "k": "bool" }, "source": "computed", "formula": { "op": "eq", "args": [{ "op": "field", "id": "vehicleConfirmed" }, { "op": "lit", "value": { "t": "bool", "v": true } }] } },
        { "id": "driverReady", "valueType": { "k": "bool" }, "source": "computed", "formula": { "op": "eq", "args": [{ "op": "field", "id": "driverConfirmed" }, { "op": "lit", "value": { "t": "bool", "v": true } }] } },
        { "id": "coverReady", "valueType": { "k": "bool" }, "source": "computed", "formula": { "op": "eq", "args": [{ "op": "field", "id": "coverConfirmed" }, { "op": "lit", "value": { "t": "bool", "v": true } }] } }
      ],
      "tables": {
        "coverRate": { "kind": "1d", "of": { "k": "money" }, "map": { "wa": { "t": "money", "minor": 400, "ccy": "EUR", "scale": 2 }, "waplus": { "t": "money", "minor": 700, "ccy": "EUR", "scale": 2 }, "allrisk": { "t": "money", "minor": 1100, "ccy": "EUR", "scale": 2 } } },
        "bandRate": { "kind": "1d", "of": { "k": "money" }, "map": { "low": { "t": "money", "minor": 100, "ccy": "EUR", "scale": 2 }, "mid": { "t": "money", "minor": 300, "ccy": "EUR", "scale": 2 }, "high": { "t": "money", "minor": 600, "ccy": "EUR", "scale": 2 } } },
        "ageRate": { "kind": "1d", "of": { "k": "money" }, "default": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "map": { "young": { "t": "money", "minor": 400, "ccy": "EUR", "scale": 2 }, "standard": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "senior": { "t": "money", "minor": 150, "ccy": "EUR", "scale": 2 } } },
        "kmRate": { "kind": "1d", "of": { "k": "money" }, "default": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "map": { "low": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "mid": { "t": "money", "minor": 150, "ccy": "EUR", "scale": 2 }, "high": { "t": "money", "minor": 350, "ccy": "EUR", "scale": 2 } } },
        "regionRate": { "kind": "1d", "of": { "k": "money" }, "default": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "map": { "low": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "mid": { "t": "money", "minor": 150, "ccy": "EUR", "scale": 2 }, "high": { "t": "money", "minor": 400, "ccy": "EUR", "scale": 2 } } },
        "usageRate": { "kind": "1d", "of": { "k": "money" }, "default": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "map": { "private": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "commute": { "t": "money", "minor": 100, "ccy": "EUR", "scale": 2 }, "business": { "t": "money", "minor": 300, "ccy": "EUR", "scale": 2 } } },
        "ncDiscount": { "kind": "1d", "of": { "k": "money" }, "default": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "map": { "none": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 }, "mid": { "t": "money", "minor": 150, "ccy": "EUR", "scale": 2 }, "high": { "t": "money", "minor": 300, "ccy": "EUR", "scale": 2 }, "max": { "t": "money", "minor": 500, "ccy": "EUR", "scale": 2 } } }
      },
      "transitions": [
        { "id": "toDriver", "field": "step", "from": "vehicle", "to": "driver", "category": "event", "when": { "op": "field", "id": "vehicleReady" } },
        { "id": "toCoverage", "field": "step", "from": "driver", "to": "coverage", "category": "event", "when": { "op": "field", "id": "driverReady" } },
        { "id": "toQuote", "field": "step", "from": "coverage", "to": "quote", "category": "event", "when": { "op": "eq", "args": [{ "op": "field", "id": "coverConfirmed" }, { "op": "lit", "value": { "t": "bool", "v": true } }] } },
        { "id": "toReview", "field": "step", "from": "quote", "to": "review", "category": "event", "when": { "op": "lit", "value": { "t": "bool", "v": true } } },
        { "id": "toSubmit", "field": "step", "from": "review", "to": "done", "category": "event", "when": { "op": "eq", "args": [{ "op": "field", "id": "termsAccepted" }, { "op": "lit", "value": { "t": "bool", "v": true } }] } }
      ]
    }
  ],
  "theme": {
    "brand": { "name": "Rowblaa Bank", "product": "Autoverzekering", "tagline": "Vertrouwd sinds 1977" },
    "fonts": {
      "ui": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "brand": "'Source Serif 4', Georgia, 'Times New Roman', serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "radius": { "sm": "8px", "md": "12px", "lg": "16px", "pill": "999px" },
    "palette": {
      "light": {
        "surface": "#e9f2fc", "surface-raised": "#ffffff", "surface-sunken": "#dbe9f9", "border": "#cbddf1",
        "ink": "#0b2140", "ink-muted": "#465b78", "ink-faint": "#7e93ad",
        "accent": "#1f6fe6", "brand": "#0b2f66", "emphasis": "#0891b2",
        "on-accent": "#ffffff", "on-brand": "#ffffff",
        "state-positive": "#0f9d76", "state-pending": "#b07d18", "state-error": "#d64550",
        "state-info": "#1f6fe6", "state-muted": "#7e93ad", "state-blocked": "#7e93ad", "state-neutral": "#465b78",
        "role-measure-ink": "#2b86c2", "role-relation-ink": "#1f6fe6",
        "accent-2": "#22b8e6"
      },
      "dark": {
        "surface": "#081426", "surface-raised": "#0f1f38", "surface-sunken": "#0c1a30", "border": "#213450",
        "ink": "#e8f1fe", "ink-muted": "#a5b7ce", "ink-faint": "#6a7e98",
        "accent": "#5b9dff", "brand": "#a9c6f5", "emphasis": "#2fd0ec",
        "on-accent": "#081426", "on-brand": "#081426",
        "state-positive": "#34c08c", "state-pending": "#e0b457", "state-error": "#f0665f",
        "state-info": "#5b9dff", "state-muted": "#6a7e98", "state-blocked": "#6a7e98", "state-neutral": "#a5b7ce",
        "role-measure-ink": "#7fb0d8", "role-relation-ink": "#5b9dff",
        "accent-2": "#3fd0ee"
      }
    }
  },
  "presentation": [
    { "subject": "applications", "variant": "journey" },
    { "subject": "applications.step", "stateRules": { "vehicle": "pending", "driver": "pending", "coverage": "pending", "quote": "info", "review": "info", "done": "positive" } },
    { "subject": "applications.cover", "stateRules": { "wa": "muted", "waplus": "info", "allrisk": "positive" } },
    { "subject": "applications.premium", "emphasis": "strong" },
    { "subject": "applications.noClaimDiscount", "role": "deduction" }
  ],
  "enums": {
    "coverLevel": [
      { "id": "wa", "label": "WA (verplicht)" },
      { "id": "waplus", "label": "WA + beperkt casco" },
      { "id": "allrisk", "label": "Allrisk" }
    ],
    "usage": [
      { "id": "private", "label": "Privé" },
      { "id": "commute", "label": "Woon-werk" },
      { "id": "business", "label": "Zakelijk" }
    ],
    "paymentTerm": [
      { "id": "monthly", "label": "Per maand" },
      { "id": "annual", "label": "Per jaar" }
    ]
  },
  "journey": {
    "field": "step",
    "confirmField": "termsAccepted",
