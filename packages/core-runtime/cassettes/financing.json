  ],
  "example": { "principal": { "t": "money", "minor": 4100000, "ccy": "EUR", "scale": 2 }, "downPayment": { "t": "money", "minor": 500000, "ccy": "EUR", "scale": 2 }, "tradeIn": { "t": "money", "minor": 250000, "ccy": "EUR", "scale": 2 }, "termMonths": { "t": "enum", "set": "term", "v": "t48" }, "loyaltyYears": { "t": "num", "v": 6 }, "grossAnnualIncome": { "t": "money", "minor": 4500000, "ccy": "EUR", "scale": 2 }, "monthlyObligations": { "t": "money", "minor": 0, "ccy": "EUR", "scale": 2 } }
